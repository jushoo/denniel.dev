# Copy this file to `.env` and fill in your values.
# `.env` is gitignored and never committed.

# Required — the website ID from your Umami dashboard.
PUBLIC_UMAMI_WEBSITE_ID=

# Optional — only needed if you self-host Umami or use a non-default script URL.
# PUBLIC_UMAMI_SRC=https://cloud.umami.is/script.js

# Optional — comma-separated list of domains to track (leave blank to track all).
# PUBLIC_UMAMI_DOMAINS=denniel.dev
