  >
    <p>&copy; {new Date().getFullYear()} denniel.dev</p>
    <div class="flex items-center gap-4">
      <a href="https://github.com/jushoo" class="link inline-flex items-center gap-1.5" target="_blank" rel="noopener noreferrer">
        <GitHubIcon size={16} />
