---
const nav = [
  { href: '/', label: 'Home' },
  { href: '/projects', label: 'Projects' },
  { href: '/about', label: 'About' },
];
const current = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="sticky top-0 z-10 border-b border-line bg-surface/80 backdrop-blur">
  <nav class="mx-auto flex w-full max-w-3xl items-center justify-between px-6 py-4">
    <a href="/" class="text-sm font-semibold tracking-tight">
      denniel.dev
    </a>
    <ul class="flex items-center gap-1">
      {
        nav.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={[
                'rounded-pill px-3 py-1.5 text-sm transition-colors',
                current === item.href
                  ? 'bg-ink font-medium text-surface'
                  : 'text-ink-soft hover:text-ink',
              ]}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
    <button
      id="theme-toggle"
      type="button"
      class="inline-flex h-8 w-8 items-center justify-center rounded-pill text-ink-soft transition-colors hover:text-ink"
      aria-label="Theme: system"
    >
      <svg data-theme-icon="light" class="hidden h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="4" />
        <path d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
      </svg>
      <svg data-theme-icon="dark" class="hidden h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
      </svg>
      <svg data-theme-icon="system" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="2" y="3" width="20" height="14" rx="2" />
        <path d="M8 21h8m-4-4v4" />
      </svg>
    </button>
  </nav>
</header>

<script>
  type Theme = 'light' | 'dark' | 'system';
  const order: Theme[] = ['light', 'dark', 'system'];
  const storageKey = 'theme';

  const root = document.documentElement;
  const button = document.getElementById('theme-toggle') as HTMLButtonElement;
  const icons = button.querySelectorAll<HTMLElement>('[data-theme-icon]');

  function storedTheme(): Theme {
    try {
      const value = localStorage.getItem(storageKey);
      if (value === 'light' || value === 'dark' || value === 'system') return value;
    } catch {
      /* storage unavailable */
    }
    return 'system';
  }

  function apply(theme: Theme): void {
    root.dataset.theme = theme;
    for (const icon of icons) {
      icon.classList.toggle('hidden', icon.dataset.themeIcon !== theme);
    }
    button.setAttribute('aria-label', `Theme: ${theme}`);
  }

  let current = storedTheme();
  apply(current);

  button.addEventListener('click', () => {
    current = order[(order.indexOf(current) + 1) % order.length];
    try {
      localStorage.setItem(storageKey, current);
    } catch {
      /* keep in-memory theme; nothing to persist */
    }
    apply(current);
  });
</script>
