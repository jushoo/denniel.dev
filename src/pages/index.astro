---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Denniel — Software Developer">
  <section class="flex flex-col gap-6">
    <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
      Hi, I'm DJ.
    </h1>
    <p class="max-w-xl text-lg leading-relaxed text-ink-soft">
    </p>
    I build software for the web and mobile phones. This site shows my projects and my work.
    <div class="mt-2 flex flex-wrap gap-3">
      <a href="/projects" class="btn-primary">View projects</a>
      <a href="mailto:denniel.joshua@gmail.com" class="btn-secondary">Get in touch</a>
    </div>
  </section>

  <section class="mt-16">
    <h2 class="mb-6 text-sm font-semibold uppercase tracking-wide text-ink-soft">
      Selected work
    </h2>
    <div class="grid gap-4 sm:grid-cols-2">
      <a
        href="/projects/johnnies-poker/"
        class="card p-6 transition-shadow hover:shadow-sm"
      >
        <h3 class="font-semibold">Johnnie's Poker</h3>
        <p class="mt-2 text-sm leading-relaxed text-ink-soft">
          A minimalist planning poker tool for agile teams.
        </p>
      </a>
      <a
        href="/projects/delete-repo-please/"
        class="card p-6 transition-shadow hover:shadow-sm"
      >
        <h3 class="font-semibold">Delete Repo Please</h3>
        <p class="mt-2 text-sm leading-relaxed text-ink-soft">
          A utility to bulk delete your github repos that you abandoned.
        </p>
      </a>
    </div>
  </section>
</Layout>
