---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Layout title="Projects — Denniel">
  <h1 class="text-3xl font-bold tracking-tight">Projects</h1>
  <p class="mt-4 max-w-xl text-lg text-ink-soft">
    A selection of things I built.
  </p>
  <div class="mt-10 grid gap-4 sm:grid-cols-2">
    {
      projects.map((project) => (
        <a
          href={`/projects/${project.id}/`}
          class="card p-6 transition-shadow hover:shadow-sm"
        >
          <div class="flex items-start justify-between gap-4">
            <h2 class="font-semibold">{project.data.title}</h2>
            {
              project.data.repo && (
                <span class="shrink-0 font-mono text-xs text-ink-soft">
                  source ↗
                </span>
              )
            }
          </div>
          <p class="mt-2 text-sm leading-relaxed text-ink-soft">
            {project.data.description}
          </p>
          {
            project.data.href && (
              <p class="mt-2 font-mono text-xs text-ink-soft">
                {project.data.href.replace('https://', '')}
              </p>
            )
          }
          <ul class="mt-4 flex flex-wrap gap-2">
            {project.data.tags.map((tag) => (
              <li class="rounded-pill border border-line px-2.5 py-0.5 font-mono text-xs text-ink-soft">
                {tag}
              </li>
            ))}
          </ul>
        </a>
      ))
    }
  </div>
</Layout>
