---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<Layout title={`${project.data.title} — Denniel`} description={project.data.description}>
  <article>
    <header class="flex flex-col gap-4">
      <a href="/projects" class="link font-mono text-xs">← all projects</a>
      <h1 class="text-3xl font-bold tracking-tight">{project.data.title}</h1>
      <p class="max-w-xl text-lg leading-relaxed text-ink-soft">
        {project.data.description}
      </p>
      {
        (project.data.href || project.data.repo) && (
          <div class="mt-2 flex items-center gap-3">
            {project.data.href && (
              <a
                href={project.data.href}
                class="btn-primary"
                target="_blank"
                rel="noopener noreferrer"
              >
                {project.data.href.replace('https://', '')} ↗
              </a>
            )}
            {project.data.repo && (
              <a
                href={project.data.repo}
                aria-label="View source on GitHub"
                class="inline-flex h-10 w-10 items-center justify-center rounded-card border border-line text-ink-soft transition-colors hover:bg-muted hover:text-ink"
                target="_blank"
                rel="noopener noreferrer"
              >
                <svg
                  viewBox="0 0 16 16"
                  width="18"
                  height="18"
                  fill="currentColor"
                  aria-hidden="true"
                >
                  <path
                    d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
                  />
                </svg>
              </a>
            )}
          </div>
        )
      }
      {
        project.data.tags.length > 0 && (
          <ul class="mt-2 flex flex-wrap gap-2">
            {project.data.tags.map((tag) => (
              <li class="rounded-pill border border-line px-2.5 py-0.5 font-mono text-xs text-ink-soft">
                {tag}
              </li>
            ))}
          </ul>
        )
      }
    </header>

    <div
      class="prose-neutral mt-10 max-w-none space-y-4 leading-relaxed [&_a]:underline [&_a]:underline-offset-4 [&_h2]:mt-10 [&_h2]:text-xl [&_h2]:font-semibold [&_p]:text-ink-soft"
    >
      <Content />
    </div>
  </article>
</Layout>
